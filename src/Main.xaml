<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Luma Stereo 1.1.2 · redokeillo" WindowStyle="None" ResizeMode="CanResize" Width="1080" Height="800" MinWidth="880" MinHeight="720" WindowStartupLocation="CenterScreen" Background="Transparent" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#F2F6FF">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F6FF"/></Style>

  <LinearGradientBrush x:Key="FrostTrack" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#776F819F" Offset="0"/><GradientStop Color="#4444536C" Offset=".5"/><GradientStop Color="#66576680" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="FrostThumb" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F0F6FCFF" Offset="0"/><GradientStop Color="#A8C2D5E6" Offset=".55"/><GradientStop Color="#E0ECF8FF" Offset="1"/></LinearGradientBrush>
  <Style x:Key="IconButton" TargetType="Button"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Foreground" Value="#F1F8FF"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="IconGlass" CornerRadius="20" Background="#30394C68" BorderBrush="#507E97B6" BorderThickness="1" Padding="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#F1F8FF"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconGlass" Property="Background" Value="#686E8AA8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="IconGlass" Property="BorderBrush" Value="#E2F4FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PowerSwitch" TargetType="CheckBox"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="PowerGlass" CornerRadius="24" Background="{StaticResource FrostTrack}" BorderBrush="#7FDEF1FF" BorderThickness="1"><Path Data="M 8,4 A 9,9 0 1 0 16,4 M12,1 L12,11" Stroke="#E4F7FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="22" Height="25"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="PowerGlass" Property="Background" Value="#A236877E"/><Setter TargetName="PowerGlass" Property="BorderBrush" Value="#D0C1FFF0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PowerGlass" Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PowerGlass" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border Background="#443D526F" CornerRadius="4"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource FrostThumb}"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
  <SolidColorBrush x:Key="Muted" Color="#AFBDD4"/>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#AFBDD4"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Glass" TargetType="Border">
   <Setter Property="CornerRadius" Value="24"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#70FFFFFF" Offset="0"/><GradientStop Color="#13FFFFFF" Offset=".42"/><GradientStop Color="#37D4E9FF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#552B3853" Offset="0"/><GradientStop Color="#B0111B2D" Offset=".6"/><GradientStop Color="#65202C46" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EFF7FF"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="20,12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="14" Background="#253B506D" BorderBrush="#50D4E8FF" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#48556B89"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B9FFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Switch" TargetType="CheckBox">
   <Setter Property="Foreground" Value="#EFF7FF"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Grid Width="52" Height="30"><Border x:Name="Rail" CornerRadius="15" Background="{StaticResource FrostTrack}" BorderBrush="#60DAEDFF" BorderThickness="1"/><Ellipse x:Name="Dot" Stroke="#BDECF6FF" StrokeThickness="1" Fill="{StaticResource FrostThumb}" Width="22" Height="22" HorizontalAlignment="Left" Margin="4,0,0,0"><Ellipse.RenderTransform><TranslateTransform x:Name="Slide"/></Ellipse.RenderTransform></Ellipse></Grid><ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="Background" Value="#4CADA6"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="22" Duration="0:0:.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Rail" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="Height" Value="28"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="6,0"><Border Height="8" Background="{StaticResource FrostTrack}" BorderBrush="#6DDCEAFF" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="22" Height="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource FrostThumb}" Stroke="#C0E9F8FF" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#EFF6FF"/><Setter Property="MinHeight" Value="38"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboGlass" CornerRadius="14" Background="#553C4C65" BorderBrush="#557C93B0" BorderThickness="1"/><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,3" Foreground="#BFD2E8"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="12,7,35,7" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#FA243149" BorderBrush="#688AA4C4" BorderThickness="1" CornerRadius="14" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Margin="0,4,0,0" Padding="4"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboGlass" Property="BorderBrush" Value="#B6E7F6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EFF6FF"/><Setter Property="Padding" Value="10,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#77577091"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#555A8399"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="MasterSlider" TargetType="Slider"><Setter Property="Height" Value="32"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="SmallChange" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent"><Border Height="8" Background="{StaticResource FrostTrack}" CornerRadius="4" VerticalAlignment="Center"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="8" CornerRadius="4" Background="{StaticResource FrostThumb}" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="32"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="3" Height="16" CornerRadius="1" Background="#F0E8F8FF"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#557F94AF" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F4FAFF"/><Setter Property="Background" Value="#233249"/><Setter Property="BorderBrush" Value="#596C87"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Grid x:Name="Root" ClipToBounds="True">
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#98111A30" Offset="0"/><GradientStop Color="#88080E1B" Offset=".55"/><GradientStop Color="#9819182B" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Image x:Name="MaximizedWallpaper" Visibility="Collapsed" Stretch="UniformToFill" IsHitTestVisible="False" Opacity="0.65"><Image.Effect><BlurEffect Radius="36"/></Image.Effect></Image>
  <Border x:Name="WallpaperTint" Background="#880C1320" Visibility="Collapsed" IsHitTestVisible="False"/>

  <Canvas x:Name="Ambient" IsHitTestVisible="False" Opacity=".9">
   <Canvas.Effect><BlurEffect Radius="5" RenderingBias="Performance"/></Canvas.Effect>
   <Path x:Name="LeftLiquid" Data="M 10,160 C -15,20 180,-45 290,55 C 400,135 340,320 225,360 C 100,420 -10,290 10,160 Z" Fill="#287C9D" Canvas.Left="50" Canvas.Top="170" RenderTransformOrigin=".5,.5"><Path.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform/><TranslateTransform/></TransformGroup></Path.RenderTransform></Path>
   <Path x:Name="RightLiquid" Data="M 10,160 C -15,20 180,-45 290,55 C 400,135 340,320 225,360 C 100,420 -10,290 10,160 Z" Fill="#8A4587" Canvas.Left="630" Canvas.Top="200" RenderTransformOrigin=".5,.5"><Path.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform/><TranslateTransform/></TransformGroup></Path.RenderTransform></Path>
  </Canvas>
  <Grid x:Name="MainContent" Margin="32,70,32,22">
   <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="126"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="LUMA / STEREO" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Two speakers. One atmosphere." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button x:Name="DashboardButton" Content="⌘   仪表盘" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="打开仪表盘"/></Grid>
   <Grid x:Name="OperationHeader" Grid.Row="1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#8292A9" Margin="0,0,9,0"/><TextBlock x:Name="Status" Text="准备连接" Style="{StaticResource Caption}"/></StackPanel><CheckBox x:Name="RunSwitch" Style="{StaticResource PowerSwitch}" ToolTip="开始 / 停止" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="开始或停止音频转发"/></Grid>
   <Grid Grid.Row="2" Margin="0,10,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border x:Name="LeftCard" Style="{StaticResource Glass}" Padding="24" VerticalAlignment="Center"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="LEFT CHANNEL" FontSize="10" Foreground="#ADD8EA"/><TextBlock Text="左音箱" FontSize="27" Margin="0,7,0,0"/><TextBlock x:Name="LeftName" Text="尚未选择设备" FontSize="12" Foreground="#C8DBEB" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/></StackPanel>
     <Grid x:Name="LeftArtwork" Grid.Row="1" Height="115" Margin="0,10"><Ellipse Width="108" Height="108" Stroke="#38D6F5FF" StrokeThickness="1"/><Ellipse Width="86" Height="86" Stroke="#35C0F6FF" StrokeThickness="1" Fill="#1325BEDB"/><TextBlock Text="L" FontFamily="Segoe UI Light" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C0F7FF"/></Grid>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="缓冲" Style="{StaticResource Caption}"/><TextBlock x:Name="LeftBuffer" Text="— ms" FontSize="20" Margin="0,5,0,0"/></StackPanel>
      <Button x:Name="LeftTrimButton" Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="相对音量" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="展开或收起左音箱相对音量"><Path Data="M1,8 L6,8 L12,3 L12,21 L6,16 L1,16 Z M16,7 Q22,12 16,17" Stroke="#EAF4FF" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/></Button>
      <Grid x:Name="LeftTrimEditor" Grid.Row="1" Grid.ColumnSpan="2" Height="0" Opacity="0" ClipToBounds="True" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><Slider x:Name="LeftTrim" Value="100" AutomationProperties.Name="左音箱相对音量"/><TextBlock x:Name="LeftTrimValue" Grid.Column="1" Text="100%" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/></Grid>
     </Grid>
    </Grid></Border>
    <Border x:Name="RightCard" Grid.Column="2" Style="{StaticResource Glass}" Padding="24" VerticalAlignment="Center"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="RIGHT CHANNEL" FontSize="10" Foreground="#DFBDEB"/><TextBlock Text="右音箱" FontSize="27" Margin="0,7,0,0"/><TextBlock x:Name="RightName" Text="尚未选择设备" FontSize="12" Foreground="#DDD2EA" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/></StackPanel>
     <Grid x:Name="RightArtwork" Grid.Row="1" Height="115" Margin="0,10"><Ellipse Width="108" Height="108" Stroke="#38F3D6FF" StrokeThickness="1"/><Ellipse Width="86" Height="86" Stroke="#35E2C0FF" StrokeThickness="1" Fill="#13B54BDB"/><TextBlock Text="R" FontFamily="Segoe UI Light" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E8CAFF"/></Grid>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="缓冲" Style="{StaticResource Caption}"/><TextBlock x:Name="RightBuffer" Text="— ms" FontSize="20" Margin="0,5,0,0"/></StackPanel>
      <Button x:Name="RightTrimButton" Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="相对音量" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="展开或收起右音箱相对音量"><Path Data="M1,8 L6,8 L12,3 L12,21 L6,16 L1,16 Z M16,7 Q22,12 16,17" Stroke="#EAF4FF" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/></Button>
      <Grid x:Name="RightTrimEditor" Grid.Row="1" Grid.ColumnSpan="2" Height="0" Opacity="0" ClipToBounds="True" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><Slider x:Name="RightTrim" Value="100" AutomationProperties.Name="右音箱相对音量"/><TextBlock x:Name="RightTrimValue" Grid.Column="1" Text="100%" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/></Grid>
     </Grid>
    </Grid></Border>
   </Grid>
   <Border x:Name="MasterPanel" Grid.Row="3" Style="{StaticResource Glass}" CornerRadius="24" Padding="24,19" Margin="0,0,0,8"><Border.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Border.RenderTransform><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="总音量" FontSize="14"/><TextBlock x:Name="MasterMode" Text="跟随系统" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><Slider Style="{StaticResource MasterSlider}" x:Name="MasterDisplay" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" AutomationProperties.Name="总音量"/><TextBlock x:Name="MasterValue" Grid.Column="2" Text="—%" FontSize="28" FontWeight="Light" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
   <Grid Grid.Row="4"><TextBlock Text="DESIGNED BY redokeillo" FontSize="10" Foreground="#98ABC4" VerticalAlignment="Center"/><TextBlock x:Name="ModeCaption" Text="低延迟模式" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
  </Grid>

  <Grid x:Name="TitleBar" VerticalAlignment="Top" Height="48" Margin="18,8,14,0" Background="Transparent">
   <TextBlock Text="LUMA / 1.1.2" FontSize="11" Foreground="#BACCE2" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
   <Border HorizontalAlignment="Right" CornerRadius="24" Background="#34384B66" BorderBrush="#445E789A" BorderThickness="1" Padding="3"><StackPanel Orientation="Horizontal">
    <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M2,8 L14,8" Stroke="#E9F5FF" StrokeThickness="1.5" Width="14" Height="14"/></Button>
    <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原"><Path Data="M2,2 L14,2 L14,14 L2,14 Z" Stroke="#E9F5FF" StrokeThickness="1.3" Width="16" Height="16"/></Button>
    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" ToolTip="退出" AutomationProperties.Name="退出"><Path Data="M3,3 L13,13 M13,3 L3,13" Stroke="#F5EDF7" StrokeThickness="1.5" Width="16" Height="16"/></Button>
   </StackPanel></Border>
  </Grid>
  <Grid x:Name="IdleBars" Opacity="0" IsHitTestVisible="False"><ProgressBar x:Name="IdleMasterBar" Width="360" Height="5" Minimum="0" Maximum="100" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="底部总音量只读条"/><Border x:Name="LeftDelayBar" Width="4" Height="48" CornerRadius="2" Background="#B090E7E9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/><Border x:Name="RightDelayBar" Width="4" Height="48" CornerRadius="2" Background="#B0DEB1F1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Grid>
  <Border x:Name="WindowOutline" BorderBrush="#456E839E" BorderThickness="1" CornerRadius="32" IsHitTestVisible="False"/>
  <Grid x:Name="Dashboard" Visibility="Collapsed" Background="#B0080D19" Margin="0,58,0,0">
   <Border Style="{StaticResource Glass}" Background="#F31A2539" Margin="32,8,32,24" Padding="24" MaxWidth="880">
    <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions>
     <Grid><StackPanel><TextBlock Text="仪表盘" FontSize="24"/><TextBlock Text="设备、校准与偏好" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Button x:Name="CloseDashboard" Content="返回  ↗" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0"><StackPanel Margin="0,0,12,0">
      <TextBlock x:Name="Notice" Text="先在 Windows 蓝牙设置中连接两只音箱，再选择来源和左右设备。" Foreground="#C7E9EE" TextWrapping="Wrap" Margin="0,0,0,18"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="音频设备" FontSize="16" VerticalAlignment="Center"/><Button x:Name="RefreshDevices" Grid.Column="1" Content="刷新设备" Padding="12,8"/></Grid>
      <TextBlock Text="声音来源 · 捕获此播放设备" Style="{StaticResource Caption}" Margin="0,14,0,7"/><ComboBox x:Name="SourceDevice" AutomationProperties.Name="声音来源设备"/>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="左音箱 · 完整设备名称" Style="{StaticResource Caption}" Margin="0,0,0,7"/><ComboBox x:Name="LeftDevice" AutomationProperties.Name="左音箱设备"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="右音箱 · 完整设备名称" Style="{StaticResource Caption}" Margin="0,0,0,7"/><ComboBox x:Name="RightDevice" AutomationProperties.Name="右音箱设备"/></StackPanel></Grid>
      <TextBlock x:Name="DeviceDetails" FontSize="11" Foreground="#ADBCD2" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock Text="声音来源需与左右输出不同。推荐安装 VB-CABLE，再把 Windows / 播放器输出设为 CABLE Input。软件不会替你安装驱动或配对蓝牙。" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,10,0,10"/>
      <StackPanel Orientation="Horizontal"><Button x:Name="BluetoothSettings" Content="蓝牙设置" Padding="14,8" Margin="0,0,10,0"/><Button x:Name="SoundSettings" Content="声音设置" Padding="14,8" Margin="0,0,10,0"/><Button x:Name="CableSite" Content="VB-CABLE 官网" Padding="14,8"/></StackPanel>
